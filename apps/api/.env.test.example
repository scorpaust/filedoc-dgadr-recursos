# Ambiente dos testes de integração (Fase 2, BD — ver test/integration/).
NODE_ENV=test
PORT=3001

# Ligação ao PostgreSQL efémero de testes (ver docker-compose.yml, serviço "postgres-test",
# perfil "test"): docker compose --profile test up -d postgres-test
# Isolado da base de dados de desenvolvimento (porta 5433) — os testes de integração
# aplicam migrações e alteram dados livremente nesta base de dados.
DATABASE_URL="postgresql://filedoc_test:filedoc_test@localhost:5434/filedoc_test?schema=public"

# Fase 1 (Integração) — Autenticação (ver .env.example para mais detalhe).
SESSION_SECRET="troque-por-um-valor-aleatorio-forte-com-pelo-menos-32-caracteres"
CORS_ALLOWED_ORIGINS=http://localhost:4200
AUTH_LOGIN_RATE_LIMIT=20

# Fase 2 (Integração) — Armazenamento de Ficheiros. MinIO de testes efémero (ver
# docker-compose.yml, serviço "minio-test", perfil "test"):
# docker compose --profile test up -d minio-test
STORAGE_ENDPOINT="http://localhost:9002"
STORAGE_BUCKET="filedoc-recursos-test"
STORAGE_ACCESS_KEY="filedoc_test"
STORAGE_SECRET_KEY="filedoc_test123"
# Limiar baixo de propósito, para exercitar o caminho de multipart upload nos testes de
# integração sem precisar de um ficheiro de teste de 100 MB.
STORAGE_MULTIPART_THRESHOLD_BYTES=5242880
STORAGE_MULTIPART_PART_SIZE_BYTES=5242880
STORAGE_ORPHAN_GRACE_PERIOD_SECONDS=0
