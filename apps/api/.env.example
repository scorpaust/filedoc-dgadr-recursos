# Ambiente da aplicação (development | production | test)
NODE_ENV=development

# Porta HTTP da API NestJS
PORT=3000

# Ligação ao PostgreSQL (ver docker-compose.yml na raiz do repositório).
# Porta 5433 no anfitrião — evita conflito com uma instância nativa de
# PostgreSQL já a ocupar a porta 5432 por omissão neste ambiente.
# A aplicação não arranca sem esta variável definida.
DATABASE_URL="postgresql://filedoc:filedoc@localhost:5433/filedoc?schema=public"

# Segredo usado como "pepper" no hash do token de sessão (Fase 1, Integração
# — auth/session-token.util.ts). Nunca reutilizar entre ambientes. Gerar,
# por exemplo, com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# A aplicação não arranca sem uma SESSION_SECRET de pelo menos 32 carateres.
SESSION_SECRET="troque-por-um-valor-aleatorio-forte-com-pelo-menos-32-caracteres"

# Duração da sessão, em segundos. Omitir para usar o valor por omissão (7 dias).
# SESSION_TTL=604800

# Origens autorizadas a chamar a API com cookies (CORS), separadas por vírgulas.
# Omitir para usar o valor por omissão de desenvolvimento (http://localhost:4200).
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Definir como "true" apenas quando a API estiver atrás de um proxy/load balancer
# que termina TLS antes da aplicação (ex. ALB), para reconhecer X-Forwarded-Proto
# e o atributo Secure do cookie de sessão se comportar corretamente.
# TRUST_PROXY=false

# Rate limiting do login (POST /auth/login), contra tentativas repetidas.
# Omitir para usar os valores por omissão (5 tentativas por 60 segundos).
# AUTH_LOGIN_RATE_LIMIT=5
# AUTH_LOGIN_RATE_TTL_SECONDS=60
