# Ambiente da aplicação (development | production | test)
NODE_ENV=development

# Porta HTTP da API NestJS
PORT=3000

# Ligação ao PostgreSQL (ver docker-compose.yml na raiz do repositório).
# Porta 5433 no anfitrião — evita conflito com uma instância nativa de
# PostgreSQL já a ocupar a porta 5432 por omissão neste ambiente.
# A aplicação não arranca sem esta variável definida.
DATABASE_URL="postgresql://filedoc:filedoc@localhost:5433/filedoc?schema=public"

# Segredo usado como "pepper" no hash do token de sessão (Fase 1, Integração
# — auth/session-token.util.ts). Nunca reutilizar entre ambientes. Gerar,
# por exemplo, com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# A aplicação não arranca sem uma SESSION_SECRET de pelo menos 32 carateres.
SESSION_SECRET="troque-por-um-valor-aleatorio-forte-com-pelo-menos-32-caracteres"

# Duração da sessão, em segundos. Omitir para usar o valor por omissão (7 dias).
# SESSION_TTL=604800

# Origens autorizadas a chamar a API com cookies (CORS), separadas por vírgulas.
# Omitir para usar o valor por omissão de desenvolvimento (http://localhost:4200).
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Definir como "true" apenas quando a API estiver atrás de um proxy/load balancer
# que termina TLS antes da aplicação (ex. ALB), para reconhecer X-Forwarded-Proto
# e o atributo Secure do cookie de sessão se comportar corretamente.
# TRUST_PROXY=false

# Rate limiting do login (POST /auth/login), contra tentativas repetidas.
# Omitir para usar os valores por omissão (5 tentativas por 60 segundos).
# AUTH_LOGIN_RATE_LIMIT=5
# AUTH_LOGIN_RATE_TTL_SECONDS=60

# Fase 10 (Integração) — rate limiting dos endpoints de escrita mais expostos a um
# utilizador comum (EMPLOYEE, sem restrição por papel): criação de pedidos de suporte e
# de anexos (POST /tickets, POST /tickets/mine/:id/attachments). Omitir para usar os
# valores por omissão (20 pedidos por 60 segundos) — acima do limite de login por não
# serem tentativas de autenticação, mas ainda bem abaixo do limite global de 100/60s.
# WRITE_RATE_LIMIT=20
# WRITE_RATE_TTL_SECONDS=60

# Fase 2 (Integração) — Armazenamento de Ficheiros (storage/). Ver
# docs/armazenamento-ficheiros.md para o significado de cada limite.
# Endereço do MinIO local (ver docker-compose.yml, serviço "minio").
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="filedoc-recursos"
# Credenciais do MinIO local — nunca reutilizar em homologação/produção.
# Num ambiente AWS real (ECS), omitir ambas: o SDK usa então a Task Role do
# ECS automaticamente (sem chaves fixas a gerir/rodar — ver
# context/features/aws/guia-aws-deployment.md, Secção 4). Têm de estar as
# duas definidas, ou as duas omissas — nunca só uma.
STORAGE_ACCESS_KEY="filedoc"
STORAGE_SECRET_KEY="filedoc123"

# Ignorada pelo MinIO, exigida pelo SDK compatível com S3. Omitir para usar "us-east-1".
# STORAGE_REGION=us-east-1

# "true" (omitir) para MinIO ou qualquer S3 acedido por endereço direto; "false" apenas
# quando o armazenamento exigir o formato de subdomínio por bucket (ex. Amazon S3 real).
# STORAGE_FORCE_PATH_STYLE=true

# Tamanho máximo, em bytes, de um único ficheiro carregado (vídeo, PDF, miniatura ou
# anexo de ticket). Omitir para usar o valor por omissão (500 MB).
# MAX_UPLOAD_SIZE=524288000

# Número máximo de anexos por ticket de suporte. Omitir para usar o valor por omissão (5).
# MAX_ATTACHMENTS_PER_TICKET=5

# Ficheiros acima deste tamanho, em bytes, usam multipart upload. Valor indicativo, a
# confirmar com ficheiros de vídeo reais (ver riscos em aberto da especificação).
# Omitir para usar o valor por omissão (100 MB).
# STORAGE_MULTIPART_THRESHOLD_BYTES=104857600

# Tamanho de cada parte de um multipart upload, em bytes (mínimo de 5 MB exigido pelo
# protocolo S3, exceto a última parte). Omitir para usar o valor por omissão (10 MB).
# STORAGE_MULTIPART_PART_SIZE_BYTES=10485760

# Duração de validade dos URLs pré-assinados de upload, em segundos. Omitir para usar o
# valor por omissão (15 minutos).
# STORAGE_UPLOAD_URL_TTL_SECONDS=900

# Duração de validade dos URLs pré-assinados de download/streaming, em segundos — ainda
# por confirmar em definitivo (ver riscos em aberto da especificação). Omitir para usar o
# valor por omissão (1 hora).
# STORAGE_DOWNLOAD_URL_TTL_SECONDS=3600

# Idade mínima, em segundos, que um objeto sem referência ativa na base de dados tem de
# ter antes de ser considerado órfão e elegível para remoção (evita apagar um upload
# recente ainda não associado a um recurso/ticket). Omitir para usar o valor por
# omissão (24 horas).
# STORAGE_ORPHAN_GRACE_PERIOD_SECONDS=86400

# Fase 10 (Integração) — política de retenção de dados (ver docs/privacidade-rgpd.md).
# Prazo, em dias, ainda sem confirmação institucional pela DGADR — omitir enquanto não
# houver decisão (a aplicação da política mantém-se manual até essa confirmação).
# RETENTION_POLICY_DAYS=
