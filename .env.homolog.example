# Modelo das variáveis exigidas pela stack de homologação
# (docker-compose.homolog.yml — Fase 5, Deployment). Documenta os NOMES das
# variáveis, nunca valores reais — ver docs/deploy-homologacao.md.
#
# Copiar para ".env.homolog" no anfitrião de homologação (nunca commitado —
# ver .gitignore), preenchido com segredos fortes e exclusivos deste
# ambiente (nunca reutilizados de desenvolvimento local nem de produção),
# geridos pelo mecanismo de segredos do anfitrião escolhido pela DGADR.
#
#   docker compose -f docker-compose.homolog.yml --env-file .env.homolog up -d

# --- Imagens a promover (Fase 4 — Amazon ECR) ------------------------------

# Tag exata já publicada por publish-images.yml para o commit/versão a
# promover (ex.: sha-1a2b3c4, ou vX.Y.Z). Nunca "latest" — a rastreabilidade
# do que está a correr em homologação depende de uma tag explícita.
IMAGE_TAG=

# Só sobrepor se as imagens não estiverem no ECR da conta/região por omissão
# (ex.: outra conta AWS ou região institucional). Requer autenticação prévia
# do Docker local ao ECR (aws ecr get-login-password | docker login ...).
# API_IMAGE=651918861047.dkr.ecr.eu-west-2.amazonaws.com/filedoc-api
# WEB_IMAGE=651918861047.dkr.ecr.eu-west-2.amazonaws.com/filedoc-web

# --- Rede -------------------------------------------------------------------

# Endereço do anfitrião a que os serviços ficam associados. Por omissão só
# o próprio anfitrião (127.0.0.1) — nunca exposto publicamente sem um
# proxy/domínio/TLS institucional confirmado à frente.
# BIND_ADDRESS=127.0.0.1

# Endereço da API alcançável a partir do browser do utilizador (não a rede
# interna do Docker) — ajustar quando existir um domínio de homologação.
# WEB_API_URL=http://localhost:3000/api/v1

# Origem pública do armazenamento de objetos (MinIO/S3), de onde o browser
# carrega PDFs/vídeos através de URLs pré-assinados — usada só para a
# diretiva Content-Security-Policy da Web (Fase 10, Hardening).
# STORAGE_PUBLIC_ORIGIN=http://localhost:9000

# Endereço do MinIO/S3 usado pela API para ASSINAR os URLs pré-assinados
# (getSignedUrl) — tem de ser o mesmo endereço que o browser consegue
# resolver, nunca o nome de serviço interno do Docker ("minio"), exceto em
# testes puramente locais. Num anfitrião público, normalmente igual a
# STORAGE_PUBLIC_ORIGIN acima. Atenção: nunca colocar atrás de um proxy que
# reescreva o caminho (ex. um prefixo "/storage" removido pelo proxy) — isso
# invalida a assinatura SigV4 dos URLs pré-assinados.
# STORAGE_ENDPOINT=http://minio:9000

# --- PostgreSQL ---------------------------------------------------------

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Armazenamento de objetos (MinIO) ---------------------------------------

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Nome do bucket usado pela API (STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY reutilizam
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD acima — ver docker-compose.homolog.yml).
STORAGE_BUCKET=

# --- Autenticação e sessão (Fase 1, Integração) ------------------------------

# Segredo usado como "pepper" no hash do token de sessão — nunca reutilizar de
# desenvolvimento local nem de produção. Gerar, por exemplo, com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Rede (continuação) ------------------------------------------------------

# Origem pública do frontend (browser do utilizador), usada para restringir o
# CORS da API. Ajustar quando existir um domínio de homologação institucional.
# WEB_PUBLIC_ORIGIN=http://localhost:8080

# --- Privacidade e RGPD (Fase 10, Hardening) ---------------------------------

# Prazo de retenção, em dias, ainda sem confirmação institucional pela DGADR
# (ver context/project-spec.md, "Privacidade e RGPD", e docs/privacidade-rgpd.md).
# Omitir enquanto não houver decisão — a política mantém-se manual até lá.
# RETENTION_POLICY_DAYS=

# --- Ainda pendente: sem valor por omissão nem decisão institucional --------
#
# SESSION_TTL, ALLOWED_EMAIL_DOMAINS, STORAGE_REGION, STORAGE_FORCE_PATH_STYLE,
# MAX_UPLOAD_SIZE, MAX_ATTACHMENTS_PER_TICKET — todas têm um valor por omissão
# de desenvolvimento razoável na API (ver apps/api/.env.example) e só precisam
# de ser explicitadas aqui se a homologação exigir um valor diferente.
